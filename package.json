    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "cypress": "^15.20.1",
    "gh-pages": "^6.3.0",
    "oxlint": "^1.75.0",
    "start-server-and-test": "^3.0.12",
    "typescript": "^7.0.2",
    "vite": "^8.2.0"
